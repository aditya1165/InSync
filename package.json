{
  "name": "insync",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "db:check": "tsx server/db/check.ts",
    "start:api": "node dist-server/server/index.js",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview",
    "test": "node --test src/lib/*.test.ts server/*.test.ts server/providers/*.test.ts server/db/*.test.ts",
    "demo:seed": "tsx server/real-demo/cli.ts seed",
    "demo:validate": "tsx server/real-demo/cli.ts validate",
    "demo:verify": "tsx server/real-demo/cli.ts verify",
    "demo:pin": "tsx server/real-demo/cli.ts pin",
    "demo:setup-task": "tsx server/real-demo/setup-cli.ts",
    "demo:cleanup": "tsx server/real-demo/cli.ts cleanup"
  },
  "dependencies": {
    "@slack/socket-mode": "^3.1.1",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.8",
    "lucide-react": "1.59.0",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
