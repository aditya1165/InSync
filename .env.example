# Keep credentials in a local .env file. It is ignored by Git.
HOST=127.0.0.1
PORT=3001

# Supabase project ref from the dashboard URL (not a secret).
# Used when linking this repository with: supabase link --project-ref <ref>
# The app does not read this value yet.
SUPABASE_PROJECT_REF=

# Required for `npm run db:check` and database-backed tasks.
# In Supabase: InSync Project > Connect > Session pooler > copy URI.
# Replace [YOUR-PASSWORD] with the database password. URL-encode special
# characters in the password. The included public Supabase root CA lets the
# backend verify the pooler certificate and hostname.
# Example format (copy the actual host and username from Supabase):
# postgresql://postgres.<project-ref>:<encoded-password>@<pooler-host>:5432/postgres?sslmode=verify-full&sslrootcert=certs/supabase-root-2021.crt
# Keep this URL only in .env; never use a VITE_ prefix for it.
DATABASE_URL=

# Local, single-user demo only. Set these to an existing Supabase Auth user ID
# and workspace ID after creating that user's membership and tasks. The API
# ignores these values in production or when HOST is not 127.0.0.1.
INSYNC_DEMO_USER_ID=
INSYNC_DEMO_WORKSPACE_ID=

# Dedicated demo repository. A token is optional for public repositories.
# Example: GITHUB_REPOSITORY=owner/repo
GITHUB_REPOSITORY=
GITHUB_TOKEN=
GITHUB_API_VERSION=2022-11-28

# Install a Slack app in the test workspace and add it to these channels.
SLACK_BOT_TOKEN=
# Example: SLACK_CHANNELS=C0123456789:backend-api,C9876543210:team-planning
SLACK_CHANNELS=

# Optional: Live Zero-Shot LLM Impact Engine (OpenAI GPT-4o)
# If omitted, InSync runs with deterministic zero-shot reasoning fixtures.
OPENAI_API_KEY=

