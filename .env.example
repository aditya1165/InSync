# Keep credentials in a local .env file. It is ignored by Git.
HOST=127.0.0.1
PORT=3001

# Supabase project ref from the dashboard URL (not a secret).
# Used when linking this repository with: supabase link --project-ref <ref>
# The app does not read this value yet.
SUPABASE_PROJECT_REF=

# Required for `npm run db:check` and database-backed tasks.
# In Supabase: InSync Project > Connect > Session pooler > copy URI.
# Replace [YOUR-PASSWORD] with the database password. URL-encode special
# characters in the password. The included public Supabase root CA lets the
# backend verify the pooler certificate and hostname.
# Example format (copy the actual host and username from Supabase):
# postgresql://postgres.<project-ref>:<encoded-password>@<pooler-host>:5432/postgres?sslmode=verify-full&sslrootcert=certs/supabase-root-2021.crt
# Keep this URL only in .env; never use a VITE_ prefix for it.
DATABASE_URL=

# Local, single-user demo only. Set these to an existing Supabase Auth user ID
# and workspace ID after demo:setup-task (dry-run first). See docs/WORKSPACE_DEMO.md. The API
# ignores these values in production or when HOST is not 127.0.0.1.
INSYNC_DEMO_USER_ID=
INSYNC_DEMO_WORKSPACE_ID=

# Dedicated demo repository. A token is optional for public repositories.
# Example: GITHUB_REPOSITORY=owner/repo
GITHUB_REPOSITORY=
GITHUB_TOKEN=
GITHUB_API_VERSION=2022-11-28

# Install a Slack app in the test workspace and add it to these channels.
SLACK_BOT_TOKEN=
# Example: SLACK_CHANNELS=C0123456789:backend-api,C9876543210:team-planning
SLACK_CHANNELS=

# Optional legacy ProfileSettings model engine; unused by the pagination workflow.
# The pagination demo uses labeled evidence rules and needs no OpenAI key.
OPENAI_API_KEY=

# Real pagination simulator: only an existing, isolated repository/channel you authorize.
# GITHUB_REPOSITORY, if set above, must agree with OWNER/REPO.
GITHUB_OWNER=
GITHUB_REPO=
SLACK_CHANNEL_ID=
# Explicit allowlists, e.g. your-account/insync-demo and C0123456789.
GITHUB_DEMO_ALLOWLIST=
SLACK_DEMO_ALLOWLIST=
# Stable run ID enables safe recovery/idempotency. Use a new ID after cleanup.
DEMO_RUN_ID=pagination-v1
# Optional custom journal path; must remain inside gitignored .demo/.
# DEMO_MANIFEST_PATH=.demo/pagination-v1.json

# Optional real-time human Slack collection (Events API over Socket Mode).
# In the SAME Slack app, enable Socket Mode and subscribe to message.channels
# (message.groups for private channels). Generate an App-Level Token with
# connections:write; this is separate from the xoxb bot token used for reads.
SLACK_EVENTS_ENABLED=false
SLACK_APP_TOKEN=

# Saved classroom replay: npm run demo:pin writes identifiers and real dates
# beside the manifest as .demo/<run>.replay.json. No new Slack event is required.
